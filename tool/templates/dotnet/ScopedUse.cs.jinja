using System;

namespace {{ namespace }}.Diplomat;

#nullable enable

internal interface IDiplomatScoped
{
    void EndScope();
}

public ref struct ScopedUse<T> where T : class
{
    private T? _value;

    internal ScopedUse(T value)
    {
        _value = value;
    }

    public bool HasValue => _value is not null;

    public T Value =>
        _value ?? throw new InvalidOperationException("This scope is empty (None) or default.");

    public void Dispose()
    {
        T? value = _value;
        _value = null;
        (value as IDiplomatScoped)?.EndScope();
    }
}
